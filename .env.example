# Copy to .env, fill the server-side key, then: node --env-file=.env server/index.js
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AVATAR_MODEL=gpt-6.1-sol
AVATAR_REQUESTS_PER_HOUR=6
PORT=18453

# Admin initialization. First successful startup stores a password hash in SQLite.
# Set a unique password of at least 12 characters. No default administrator password.
ADMIN_PASSWORD=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this same key across restarts. Do not commit it or lose it.
ADMIN_ENCRYPTION_KEY=
# Use 1 when accessed through HTTPS in production. Keep 0 for local HTTP testing.
ADMIN_COOKIE_SECURE=0
# Only set 1 behind your own reverse proxy which replaces X-Forwarded-For.
TRUST_PROXY=0
