# Copy to .env, fill the server-side key, then: node --env-file=.env server/index.js
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AVATAR_MODEL=gpt-6.1-sol
AVATAR_REQUESTS_PER_HOUR=6
PORT=18453

# Admin initialization. First successful startup stores a password hash in SQLite.
# Set a unique password of at least 12 characters. No default administrator password.
ADMIN_PASSWORD=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this same key across restarts. Do not commit it or lose it.
ADMIN_ENCRYPTION_KEY=
# Secure is automatic on TLS or trusted proxy HTTPS. Legacy 1 forces Secure even on HTTP.
# Keep 0 for local HTTP and for automatic per-request detection.
ADMIN_COOKIE_SECURE=0
# Only set 1 behind your own proxy replacing X-Forwarded-For AND X-Forwarded-Proto.
# Block direct public access to the Node port when trusting a proxy.
TRUST_PROXY=0

# Optional direct HTTPS: paths to PEM files outside the repo. Set both or neither.
TLS_CERT=
TLS_KEY=
# Optional one-day HSTS; emitted only for TLS / trusted proxy HTTPS responses.
HSTS=0
# Set your public hostname for the deploy/compose.yml Caddy example.
DOMAIN=
